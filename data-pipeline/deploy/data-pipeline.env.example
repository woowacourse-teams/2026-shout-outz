# /etc/shout-outz/data-pipeline.env 견본(08 문서 C12, 7-4). 값은 EC2 에서 직접 넣는다. 이 견본에는 값을 쓰지 않는다.
# sudo mkdir -p /etc/shout-outz && sudo cp deploy/data-pipeline.env.example /etc/shout-outz/data-pipeline.env
# sudo chmod 600 /etc/shout-outz/data-pipeline.env && sudo nano /etc/shout-outz/data-pipeline.env

# 원본 저장소(C13)
PIPELINE_STORE=s3://techcourse-project-2026/shout-outz/data-pipeline
AWS_REGION=ap-northeast-2

# GitHub: 팀 계정의 권한 없는 fine-grained 토큰(공개 레포 읽기만, 06 문서 5-8)
GITHUB_TOKEN=

# YouTube Data API v3 키(04 문서 7-3)
YOUTUBE_API_KEY=

# 서비스 DB(블로그 대상 읽기, 읽기 전용, 03 문서 2-2). 비밀번호를 비우면 EC2 역할로 RDS IAM 인증 토큰을 만든다
SERVICE_DB_HOST=
SERVICE_DB_PORT=5432
SERVICE_DB_NAME=
SERVICE_DB_USER=
SERVICE_DB_PASSWORD=
