# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# webpack.config.js의 dotenv.prefix에 등록된 접두사(API_ORIGIN, POSTHOG_)만 번들에 주입된다.

# API 서버 주소. 비워두면 현재 도메인으로 요청하고 개발 환경에서는 MSW가 응답한다.
API_ORIGIN=

# 사용자 행동 수집(PostHog). 자세한 내용은 docs/analytics.md 참고.
# 로컬에서는 비워둔다. 비어 있으면 콘솔 어댑터만 동작해 브라우저 콘솔에서 이벤트를 확인할 수 있다.
# 값을 넣으면 로컬 클릭도 실제 PostHog 프로젝트에 쌓인다.
POSTHOG_KEY=
# 기본값은 https://us.i.posthog.com. EU 리전이면 https://eu.i.posthog.com
POSTHOG_HOST=
