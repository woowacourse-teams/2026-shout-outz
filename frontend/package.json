{
    "version": "1.0.0",
    "description": "shout-outz frontend repository",
    "name": "shout-outz-frontend",
    "type": "module",
    "scripts": {
        "build": "npm run build:client && npm run build:static",
        "build:client": "webpack --mode=production --config-node-env=production",
        "build:static": "webpack --mode=production --config ssg/webpack.config.js && node ssg/.build/generate-static-site.cjs",
        "build:dev": "webpack --mode=development --config ssg/webpack.config.js && node ssg/.build/generate-static-site.cjs --csr-shell",
        "predev": "npm run build:dev",
        "dev": "webpack serve",
        "start": "serve -s dist",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@swc/core": "^1.15.47",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@tanstack/router-plugin": "^1.168.32",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "css-loader": "^7.1.4",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "mini-css-extract-plugin": "^2.10.2",
        "postcss": "^8.5.25",
        "postcss-loader": "^8.2.1",
        "serve": "^14.2.6",
        "style-loader": "^4.0.0",
        "swc-loader": "^0.2.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^5.2.6",
        "webpack-manifest-plugin": "^6.0.1"
    },
    "dependencies": {
        "@swc/helpers": "^0.5.23",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-router": "^1.170.29",
        "core-js": "^3.50.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "browserslist": [
        "> 0.5%",
        "not dead"
    ]
}
