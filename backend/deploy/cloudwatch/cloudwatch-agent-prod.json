{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "ShoutOutz",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"]
      },
      "swap": {
        "measurement": ["swap_used_percent"]
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"],
        "drop_device": true
      }
    }
  },
  "logs": {
    "metrics_collected": {
      "prometheus": {
        "log_group_name": "/shout-outz/prod/prometheus",
        "prometheus_config_path": "/opt/aws/amazon-cloudwatch-agent/etc/prometheus.yaml",
        "emf_processor": {
          "metric_declaration_dedup": false,
          "metric_namespace": "ShoutOutz",
          "metric_unit": {
            "http_server_requests_seconds_count": "Count",
            "http_server_requests_seconds_sum": "Seconds",
            "http_server_requests_seconds_max": "Seconds",
            "hikaricp_connections_active": "Count",
            "hikaricp_connections_idle": "Count",
            "hikaricp_connections_pending": "Count"
          },
          "metric_declaration": [
            {
              "source_labels": ["job"],
              "label_matcher": "^shout-outz-app$",
              "dimensions": [["env"]],
              "metric_selectors": [
                "^http_server_requests_seconds_(count|sum|max)$",
                "^hikaricp_connections_(active|idle|pending)$"
              ]
            }
          ]
        }
      }
    },
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/shout-outz/app.log",
            "log_group_name": "/shout-outz/prod/app",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "UTC",
            "multi_line_start_pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          }
        ]
      }
    }
  }
}
