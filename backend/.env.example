SUPABASE_DB_URL=jdbc:postgresql://<project-host>:5432/postgres
SUPABASE_DB_USERNAME=<backend-db-user>
SUPABASE_DB_PASSWORD=<backend-db-password>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_JWK_SET_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 signing projects can use this instead of SUPABASE_JWT_JWK_SET_URI.
SUPABASE_JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
VIRTUAL_THREADS_ENABLED=false
